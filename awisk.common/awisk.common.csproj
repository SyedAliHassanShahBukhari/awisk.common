<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<GeneratePackageOnBuild>true</GeneratePackageOnBuild>

		<!-- Package Identity -->
		<PackageId>awisk.Common</PackageId>
		<Version>3.0.1</Version>
		<AssemblyVersion>3.0.1.0</AssemblyVersion>
		<FileVersion>3.0.1.0</FileVersion>

		<!-- Authorship -->
		<Authors>Syed Ali Hassan</Authors>
		<Company>awisk</Company>
		<Copyright>Copyright © 2024-2026 awisk</Copyright>

		<!-- Package Description -->
		<Description>A comprehensive .NET 10 shared utility library for ASP.NET Core projects. Provides a Dapper-based generic repository pattern for SQL Server, MySQL, and PostgreSQL; a functional Result&lt;T&gt; error-handling type; pagination DTOs; JWT authentication helpers; ICurrentUserService; ICacheService with in-memory and Redis backends; IEmailService via MailKit SMTP; IFileStorageService for local disk storage; Correlation ID and request/response logging middleware; EF Core audit interceptor and soft-delete global query filter; health checks; FluentMigrator integration; EnumHelper; and a rich set of UniversalOperations extension methods.</Description>
		<PackageTags>aspnetcore;dotnet;utilities;helpers;common;dapper;repository;result-pattern;jwt;caching;redis;email;mailkit;efcore;audit;soft-delete;pagination;middleware;correlation-id;health-checks;fluent-migrator;sqlserver;mysql;postgresql;awisk</PackageTags>

		<!-- URLs -->
		<PackageProjectUrl>https://github.com/SyedAliHassanShahBukhari/awisk.common</PackageProjectUrl>
		<RepositoryUrl>https://github.com/SyedAliHassanShahBukhari/awisk.common.git</RepositoryUrl>
		<RepositoryType>git</RepositoryType>

		<!-- Release Notes -->
		<PackageReleaseNotes>v3.0.0 — Upgraded to .NET 10. Added ICurrentUserService, ICacheService (memory + Redis), IEmailService (MailKit SMTP), IFileStorageService, CorrelationIdMiddleware, RequestResponseLoggingMiddleware, EF Core AuditInterceptor, soft-delete global query filter, health check extensions, CancellationToken propagation across all async repository methods, and Result&lt;T&gt; Map/Bind/Match operators. See full changelog: https://github.com/SyedAliHassanShahBukhari/awisk.common/blob/master/CHANGELOG.md</PackageReleaseNotes>

		<!-- Documentation -->
		<PackageLicenseFile>LICENSE.txt</PackageLicenseFile>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
	</PropertyGroup>

	<ItemGroup>
		<Folder Include="DTOs\Requests\" />
	</ItemGroup>
	<ItemGroup>
		<None Include="LICENSE.txt" Pack="true" PackagePath="" />
		<None Include="NOTICE.txt" Pack="true" PackagePath="" />
		<None Include="README.md" Pack="true" PackagePath="" />
	</ItemGroup>
	<ItemGroup>
	  <PackageReference Include="AspNetCore.HealthChecks.MySql" Version="9.0.0" />
	  <PackageReference Include="AspNetCore.HealthChecks.NpgSql" Version="9.0.0" />
	  <PackageReference Include="AspNetCore.HealthChecks.SqlServer" Version="9.0.0" />
	  <PackageReference Include="Dapper.Contrib" Version="2.0.78" />
	  <PackageReference Include="MailKit" Version="4.16.0" />
	  <PackageReference Include="Microsoft.Extensions.Caching.Memory" Version="10.0.7" />
	  <PackageReference Include="Microsoft.Extensions.Caching.StackExchangeRedis" Version="10.0.7" />
	  <PackageReference Include="StackExchange.Redis" Version="2.12.14" />
	  <PackageReference Include="FluentMigrator" Version="8.0.1" />
	  <PackageReference Include="FluentMigrator.Runner" Version="8.0.1" />
	  <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.7" />
	  <PackageReference Include="Microsoft.AspNetCore.Diagnostics.EntityFrameworkCore" Version="10.0.7" />
	  <PackageReference Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" Version="10.0.7" />
	  <PackageReference Include="Microsoft.Data.SqlClient" Version="7.0.1" />
	  <PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.7" />
	  <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.7" />
	  <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.7" />
	  <PackageReference Include="McMaster.Extensions.CommandLineUtils" Version="4.1.1" />
	  <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.7" />
	  <PackageReference Include="MySql.Data" Version="9.7.0" />
	  <PackageReference Include="Npgsql" Version="10.0.2" />
	  <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.1" />
	  <PackageReference Include="Pomelo.EntityFrameworkCore.MySql" Version="9.0.0" />
	  <PackageReference Include="Microsoft.OpenApi" Version="3.5.3" />
	  <PackageReference Include="Swashbuckle.AspNetCore" Version="10.1.7" />
	  <PackageReference Include="System.IdentityModel.Tokens.Jwt" Version="8.18.0" />
	</ItemGroup>

</Project>
